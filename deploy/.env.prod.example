# Production Compose env — copy to repo root as `.env.prod`:
#   cp deploy/.env.prod.example .env.prod

NODE_ENV=production
LOG_LEVEL=info
JACKLINE_TENANCY=single

# Required secrets (generate with: openssl rand -base64 32)
JACKLINE_MASTER_KEY=
BETTER_AUTH_SECRET=

JACKLINE_SECRET_STORAGE_LOCATION=local
POSTGRES_PASSWORD=jackline

# Production VM uses Cloud SQL (private IP). CI / pulumi startup set these:
# DATABASE_URL=postgresql://jackline:PASSWORD@10.x.x.x:5432/jackline
# CLOUD_SQL_CONNECTION_NAME=project:region:jackline-db

# --- Public URLs (what browsers / MCP clients see) ---
# Default: local HTTP via Caddy on :80 (same origin for UI + API + MCP).
JACKLINE_SITE_ADDRESS=http://localhost
JACKLINE_DOCS_SITE_ADDRESS=http://docs.localhost
JACKLINE_HTTP_PORT=80
JACKLINE_HTTPS_PORT=443
# Optional Caddy global options (e.g. ACME contact for Let's Encrypt):
# JACKLINE_CADDY_GLOBAL_OPTIONS=email you@example.com
JACKLINE_CADDY_GLOBAL_OPTIONS=

WEB_ORIGIN=http://localhost
BETTER_AUTH_URL=http://localhost
JACKLINE_PUBLIC_API_URL=http://localhost
JACKLINE_PUBLIC_MCP_URL=http://localhost/mcp
# API → gateway (in-product Chat). Compose service DNS, not localhost.
JACKLINE_INTERNAL_MCP_URL=http://gateway:8081/mcp

# Extra CORS / Better Auth origins (comma-separated). Needed if UI host ≠ API
# host beyond WEB_ORIGIN, or for additional preview origins.
# JACKLINE_ADDITIONAL_ORIGINS=https://app.example.com

# --- Real domain + HTTPS (Let's Encrypt) example ---
# Point DNS A/AAAA for jackline.example.com and docs.jackline.example.com at this host.
# Use bare hostnames (no http://) so Caddy enables HTTPS automatically:
# JACKLINE_SITE_ADDRESS=jackline.example.com
# JACKLINE_DOCS_SITE_ADDRESS=docs.jackline.example.com
# JACKLINE_CADDY_GLOBAL_OPTIONS=email you@example.com
# WEB_ORIGIN=https://jackline.example.com
# BETTER_AUTH_URL=https://jackline.example.com
# JACKLINE_PUBLIC_API_URL=https://jackline.example.com
# JACKLINE_PUBLIC_MCP_URL=https://jackline.example.com/mcp

# --- Gateway-split overlay (compose.gateway-split.yml) example ---
# JACKLINE_GATEWAY_PUBLISH_PORT=8081
# JACKLINE_PUBLIC_MCP_URL=http://127.0.0.1:8081/mcp
# # or https://mcp.example.com/mcp behind your own TLS terminator

# --- BYO edge overlay (compose.byo-edge.yml) publish ports ---
# JACKLINE_API_PUBLISH_PORT=8080
# JACKLINE_GATEWAY_PUBLISH_PORT=8081
# JACKLINE_WEB_PUBLISH_PORT=8088
# JACKLINE_DOCS_PUBLISH_PORT=8089

# Bound inside containers (override only if needed)
API_HOST=0.0.0.0
API_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8081

# Optional OpenTelemetry trace export (stdout JSON logs are always emitted)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_TRACES_SAMPLER_ARG=0.1

# Optional inbound SSO
JACKLINE_OIDC_ISSUER=
JACKLINE_OIDC_CLIENT_ID=
JACKLINE_OIDC_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_CONNECTOR=console
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
