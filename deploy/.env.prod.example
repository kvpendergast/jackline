# Production Compose env — copy to repo root as `.env.prod`:
#   cp deploy/.env.prod.example .env.prod

NODE_ENV=production
LOG_LEVEL=info
MESH_TENANCY=single

# Required secrets (generate with: openssl rand -base64 32)
MESH_MASTER_KEY=
BETTER_AUTH_SECRET=

MESH_SECRET_STORAGE_LOCATION=local
POSTGRES_PASSWORD=mesh

# Public URLs as browsers see them (Caddy on :80)
MESH_HOST=localhost
MESH_HTTP_PORT=80
WEB_ORIGIN=http://localhost
BETTER_AUTH_URL=http://localhost
MESH_PUBLIC_API_URL=http://localhost
MESH_PUBLIC_MCP_URL=http://localhost/mcp

# Bound inside containers (override only if needed)
API_HOST=0.0.0.0
API_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8081

# Optional inbound SSO
MESH_OIDC_ISSUER=
MESH_OIDC_CLIENT_ID=
MESH_OIDC_CLIENT_SECRET=
