# Mesh edge proxy — control plane only (UI + API).
# Use with compose.gateway-split.yml; MCP is published on the gateway service directly.
#
# Set MESH_PUBLIC_MCP_URL to the gateway's public URL (e.g. https://mcp.example.com/mcp).
{
	{$MESH_CADDY_GLOBAL_OPTIONS}
}

{$MESH_SITE_ADDRESS} {
	encode gzip

	handle /api* {
		reverse_proxy api:8080
	}

	handle /scim* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle /openapi.json {
		rewrite * /docs
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}

{$MESH_DOCS_SITE_ADDRESS} {
	encode gzip
	reverse_proxy docs:80
}
