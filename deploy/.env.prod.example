# Production Compose env — copy to repo root as `.env.prod`:
#   cp deploy/.env.prod.example .env.prod

NODE_ENV=production
LOG_LEVEL=info
MESH_TENANCY=single

# Required secrets (generate with: openssl rand -base64 32)
MESH_MASTER_KEY=
BETTER_AUTH_SECRET=

MESH_SECRET_STORAGE_LOCATION=local
POSTGRES_PASSWORD=mesh

# --- Public URLs (what browsers / MCP clients see) ---
# Default: local HTTP via Caddy on :80 (same origin for UI + API + MCP).
MESH_SITE_ADDRESS=http://localhost
MESH_DOCS_SITE_ADDRESS=http://docs.localhost
MESH_HTTP_PORT=80
MESH_HTTPS_PORT=443
# Optional Caddy global options (e.g. ACME contact for Let's Encrypt):
# MESH_CADDY_GLOBAL_OPTIONS=email you@example.com
MESH_CADDY_GLOBAL_OPTIONS=

WEB_ORIGIN=http://localhost
BETTER_AUTH_URL=http://localhost
MESH_PUBLIC_API_URL=http://localhost
MESH_PUBLIC_MCP_URL=http://localhost/mcp

# Extra CORS / Better Auth origins (comma-separated). Needed if UI host ≠ API
# host beyond WEB_ORIGIN, or for additional preview origins.
# MESH_ADDITIONAL_ORIGINS=https://app.example.com

# --- Real domain + HTTPS (Let's Encrypt) example ---
# Point DNS A/AAAA for mesh.example.com and docs.mesh.example.com at this host.
# Use bare hostnames (no http://) so Caddy enables HTTPS automatically:
# MESH_SITE_ADDRESS=mesh.example.com
# MESH_DOCS_SITE_ADDRESS=docs.mesh.example.com
# MESH_CADDY_GLOBAL_OPTIONS=email you@example.com
# WEB_ORIGIN=https://mesh.example.com
# BETTER_AUTH_URL=https://mesh.example.com
# MESH_PUBLIC_API_URL=https://mesh.example.com
# MESH_PUBLIC_MCP_URL=https://mesh.example.com/mcp

# --- Gateway-split overlay (compose.gateway-split.yml) example ---
# MESH_GATEWAY_PUBLISH_PORT=8081
# MESH_PUBLIC_MCP_URL=http://127.0.0.1:8081/mcp
# # or https://mcp.example.com/mcp behind your own TLS terminator

# --- BYO edge overlay (compose.byo-edge.yml) publish ports ---
# MESH_API_PUBLISH_PORT=8080
# MESH_GATEWAY_PUBLISH_PORT=8081
# MESH_WEB_PUBLISH_PORT=8088
# MESH_DOCS_PUBLISH_PORT=8089

# Bound inside containers (override only if needed)
API_HOST=0.0.0.0
API_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8081

# Optional inbound SSO
MESH_OIDC_ISSUER=
MESH_OIDC_CLIENT_ID=
MESH_OIDC_CLIENT_SECRET=
