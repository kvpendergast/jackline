# Mesh edge proxy — default all-in-one topology (UI + API + MCP on one site).
#
# MESH_SITE_ADDRESS controls HTTP vs HTTPS:
#   Local:        http://localhost
#   Let's Encrypt: mesh.example.com   (no scheme — Caddy enables HTTPS)
#
# Docs site is separate (subdomain or alternate host):
#   Local:        http://docs.localhost
#   Production:   docs.mesh.example.com
{
	{$MESH_CADDY_GLOBAL_OPTIONS}
}

{$MESH_SITE_ADDRESS} {
	encode gzip

	handle /mcp* {
		reverse_proxy gateway:8081
	}

	handle /api* {
		reverse_proxy api:8080
	}

	handle /scim* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle /openapi.json {
		rewrite * /docs
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}

{$MESH_DOCS_SITE_ADDRESS} {
	encode gzip
	reverse_proxy docs:80
}
