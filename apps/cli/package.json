{
  "name": "@buildstuff/jackline",
  "version": "0.1.0",
  "description": "Personal Jackline CLI — local MCP policy gateway",
  "type": "module",
  "license": "MIT",
  "author": "Jackline contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvpendergast/jackline.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/kvpendergast/jackline/tree/main/apps/cli",
  "bugs": {
    "url": "https://github.com/kvpendergast/jackline/issues"
  },
  "keywords": [
    "mcp",
    "cli",
    "gateway",
    "policy",
    "jackline",
    "buildstuff",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jackline": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-force-exit \"src/**/*.test.ts\"",
    "lint": "echo \"lint later\""
  },
  "devDependencies": {
    "@jackline/crypto": "workspace:*",
    "@jackline/shared": "workspace:*",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "hono": "^4.12.30",
    "neverthrow": "^8.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
