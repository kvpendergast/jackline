{
  "name": "jackline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @jackline/api --filter @jackline/web --filter @jackline/gateway dev",
    "docs:dev": "pnpm --filter @jackline/docs dev",
    "marketing:dev": "pnpm --filter @jackline/marketing dev",
    "docs:build": "pnpm --filter @jackline/docs build",
    "openapi:export": "pnpm --filter @jackline/api openapi:export",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --sort typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @jackline/db generate",
    "db:migrate": "pnpm --filter @jackline/db migrate",
    "test:integration": "pnpm --filter @jackline/integration-tests test:integration",
    "env:check": "pnpm --filter @jackline/shared env:check"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
