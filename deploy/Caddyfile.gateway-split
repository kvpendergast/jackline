# Jackline edge proxy — control plane only (UI + API).
# Use with compose.gateway-split.yml; MCP is published on the gateway service directly.
#
# Set JACKLINE_PUBLIC_MCP_URL to the gateway's public URL (e.g. https://mcp.example.com/mcp).
{
	{$JACKLINE_CADDY_GLOBAL_OPTIONS}
}

{$JACKLINE_SITE_ADDRESS} {
	handle /api/v1/chat {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle /api* {
		encode gzip
		reverse_proxy api:8080
	}

	handle /scim* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle /openapi.json {
		rewrite * /docs
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}

{$JACKLINE_DOCS_SITE_ADDRESS} {
	encode gzip
	reverse_proxy docs:80
}
