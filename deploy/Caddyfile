# Jackline edge proxy — default all-in-one topology (UI + API + MCP on one site).
#
# JACKLINE_SITE_ADDRESS controls HTTP vs HTTPS:
#   Local:        http://localhost
#   Let's Encrypt: jackline.example.com   (no scheme — Caddy enables HTTPS)
#
# Docs site is separate (subdomain or alternate host):
#   Local:        http://docs.localhost
#   Production:   docs.jackline.example.com
{
	{$JACKLINE_CADDY_GLOBAL_OPTIONS}
}

{$JACKLINE_SITE_ADDRESS} {
	handle /api/v1/chat {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}

	handle /mcp* {
		encode gzip
		reverse_proxy gateway:8081
	}

	handle /api* {
		encode gzip
		reverse_proxy api:8080
	}

	handle /scim* {
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle /openapi.json {
		rewrite * /docs
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}
}

{$JACKLINE_DOCS_SITE_ADDRESS} {
	encode gzip
	reverse_proxy docs:80
}
