    "@tanstack/ai-anthropic": "^0.19.3",
    "@tanstack/ai-openai": "^0.25.1",
    "@tanstack/ai-openrouter": "^0.20.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
