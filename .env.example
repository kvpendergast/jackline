NODE_ENV=development
LOG_LEVEL=info
JACKLINE_TENANCY=single
JACKLINE_MASTER_KEY=
JACKLINE_SECRET_STORAGE_LOCATION=local

# Local Postgres — set POSTGRES_PASSWORD in .env (not committed).
POSTGRES_USER=jackline
POSTGRES_PASSWORD=
POSTGRES_DB=jackline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Native dev: localhost. Docker Compose overrides host to postgres inside the stack.
DATABASE_URL=

API_HOST=127.0.0.1
API_PORT=8080
WEB_ORIGIN=http://127.0.0.1:5173
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8081
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8080
# Public URL for upstream OAuth callbacks (ngrok → API :8080). Leave unset normally.
JACKLINE_PUBLIC_API_URL=
# Public MCP URL embedded in minted connection credentials (Compose prod: http://localhost/mcp)
JACKLINE_PUBLIC_MCP_URL=
# Extra CORS / Better Auth origins (comma-separated) for split UI/API hosts
JACKLINE_ADDITIONAL_ORIGINS=
# API → gateway MCP URL for in-product Chat (compose: http://gateway:8081/mcp)
JACKLINE_INTERNAL_MCP_URL=
JACKLINE_OIDC_ISSUER=
JACKLINE_OIDC_CLIENT_ID=
JACKLINE_OIDC_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Platform outbound email (verification + notifications)
EMAIL_CONNECTOR=console
# OpenTelemetry trace export (optional — logs always stay on stdout as JSON)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_TRACES_SAMPLER_ARG=1
EMAIL_FROM=
RESEND_API_KEY=
# SMTP connector (when EMAIL_CONNECTOR=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
