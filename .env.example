NODE_ENV=development
LOG_LEVEL=info
MESH_TENANCY=single
MESH_MASTER_KEY=
MESH_SECRET_STORAGE_LOCATION=local
DATABASE_URL=postgresql://mesh:mesh@localhost:5432/mesh
API_HOST=127.0.0.1
API_PORT=8080
WEB_ORIGIN=http://127.0.0.1:5173
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8081
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:8080
# Public URL for upstream OAuth callbacks (ngrok → API :8080). Leave unset normally.
MESH_PUBLIC_API_URL=
# Public MCP URL embedded in minted connection credentials (Compose prod: http://localhost/mcp)
MESH_PUBLIC_MCP_URL=
# Extra CORS / Better Auth origins (comma-separated) for split UI/API hosts
MESH_ADDITIONAL_ORIGINS=
MESH_OIDC_ISSUER=
MESH_OIDC_CLIENT_ID=
MESH_OIDC_CLIENT_SECRET=
