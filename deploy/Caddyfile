# Jackline edge proxy — default all-in-one topology (UI + API + MCP on one site).
#
# JACKLINE_SITE_ADDRESS controls HTTP vs HTTPS:
#   Local:        http://localhost
#   Let's Encrypt: jackline.example.com   (no scheme — Caddy enables HTTPS)
#
# Docs site is separate (subdomain or alternate host):
#   Local:        http://docs.localhost
#   Production:   docs.jackline.example.com
#
# During a rolling deploy Compose briefly has two replicas behind the same
# service name. Active health_uri + fail_duration skip a replica that is not
# ready; remote-deploy.sh also keeps the old container until Docker health is
# green, then reloads Caddy so it re-resolves DNS.
{
	{$JACKLINE_CADDY_GLOBAL_OPTIONS}
}

(api_proxy) {
	reverse_proxy api:8080 {
		health_uri /health
		health_interval 5s
		health_timeout 2s
		fail_duration 10s
		unhealthy_status 5xx
	}
}

{$JACKLINE_SITE_ADDRESS} {
	handle /api/v1/chat {
		reverse_proxy api:8080 {
			flush_interval -1
			health_uri /health
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			unhealthy_status 5xx
		}
	}

	handle /mcp* {
		encode gzip
		reverse_proxy gateway:8081 {
			health_uri /health
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			unhealthy_status 5xx
		}
	}

	handle /api* {
		encode gzip
		import api_proxy
	}

	handle /scim* {
		import api_proxy
	}

	handle /health {
		import api_proxy
	}

	handle /openapi.json {
		rewrite * /docs
		import api_proxy
	}

	handle {
		reverse_proxy web:80 {
			health_uri /
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			unhealthy_status 5xx
		}
	}
}

{$JACKLINE_DOCS_SITE_ADDRESS} {
	encode gzip
	reverse_proxy docs:80 {
		health_uri /
		health_interval 5s
		health_timeout 2s
		fail_duration 10s
		unhealthy_status 5xx
	}
}
